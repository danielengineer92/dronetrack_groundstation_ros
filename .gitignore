# ROS 2 / colcon
ros_ws/build/
ros_ws/install/
ros_ws/log/

# Flight packages are now VENDORED + version-controlled here as the single source
# of truth (originally derived from dronetrack_pi_ros). setup_*.sh still no-op
# copies them only if absent, so existing setup flows keep working.

# Generated / local-only
configs/network.yaml
configs/cyclonedds.xml
ros_ws/src/*/config/

# Model weights (*.pt / *.onnx / *.engine) ARE tracked now, committed straight
# into git — losing the trained red-ball model once was enough. They're small
# (~19 MB), well under GitHub's 100 MB/file limit, so no LFS needed.
# Datasets stay OUT of the repo — keep them under ~/Documents/Python/, not here.
datasets/
*.zip

# Python
__pycache__/
*.pyc
.venv/

# Editor
.vscode/
.idea/

# Backups / scratch
*.bak
*.bak_*
*.backup*
*.orig
*~

# Top-level colcon build logs (COLCON_IGNORE marker dir)
/log/
